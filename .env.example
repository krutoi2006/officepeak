NUXT_SMTP_HOST=smtp.yandex.ru
NUXT_SMTP_PORT=465
NUXT_SMTP_SECURE=true
NUXT_SMTP_USER=OFFICEPEAK.1@yandex.ru
NUXT_SMTP_PASS=your-app-password
NUXT_SMTP_FROM="OFFICEPEAK <OFFICEPEAK.1@yandex.ru>"
NUXT_SMTP_TO=OFFICEPEAK.1@yandex.ru

# Unitex is server-only. Never expose these values through NUXT_PUBLIC_*.
UNITEX_API_TOKEN=replace-with-server-token
UNITEX_CATALOG_STORAGE_DIR=/absolute/persistent/path/to/catalog
UNITEX_SYNC_CITY=moscow
UNITEX_API_BASE_URL=https://api.unitex.ru/
UNITEX_SYNC_TIMEOUT_MS=21600000
UNITEX_SYNC_MAX_RETRIES=4

# Riva is server-only. Never expose these values through NUXT_PUBLIC_*.
RIVA_API_ID=replace-with-server-id
RIVA_API_BASE_URL=https://riva.ru/api/
# If omitted, UNITEX_CATALOG_STORAGE_DIR is used.
RIVA_CATALOG_STORAGE_DIR=/absolute/persistent/path/to/catalog
RIVA_SYNC_TIMEOUT_MS=7200000
RIVA_SYNC_MAX_RETRIES=3
