{
  "name": "officepeak",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "catalog:sync:unitex": "node --env-file-if-exists=.env scripts/catalog-sync-unitex.mjs",
    "catalog:sync:riva": "node --env-file-if-exists=.env scripts/catalog-sync-riva.mjs",
    "catalog:export:static": "node scripts/export-static-catalog.mjs",
    "test:unitex": "node --test tests/unitex-sync.test.mjs",
    "test:riva": "node --test tests/riva-sync.test.mjs",
    "test:catalog-sync": "node --test tests/unitex-sync.test.mjs tests/riva-sync.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:catalog": "node scripts/catalog-smoke.mjs",
    "smoke:smtp": "node scripts/smtp-smoke.mjs"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "lucide-vue-next": "^0.468.0",
    "nodemailer": "^10.0.1",
    "nuxt": "^3.15.0",
    "sax": "^1.6.0",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^2.2.0"
  }
}
